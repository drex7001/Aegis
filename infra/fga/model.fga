# Aegis authorization model — human-readable DSL source (speckit spec 03 §3).
# The API-consumable form is model.json (kept in sync BY HAND until the openfga
# CLI is adopted; if you edit this file, regenerate/update model.json to match:
#   fga model transform --file infra/fga/model.fga > infra/fga/model.json
# `make bootstrap` pushes model.json to the local OpenFGA store).

model
  schema 1.1

type user

type case
  relations
    define supervisor: [user]
    define investigator: [user]
    define analyst: [user]
    define auditor_grant: [user]
    define member: investigator or analyst or supervisor
    define can_view: member or auditor_grant
    define can_edit: investigator or analyst or supervisor
    define can_approve: supervisor

type compartment
  relations
    define member: [user]
    define can_view: member

type evidence_item
  relations
    define case: [case]
    define custodian: [user]
    define can_view: can_view from case
    define can_transfer: custodian or can_approve from case

# The investigation's operational plane (T43, spec 09 §5). Neither type has any
# authorization of its own: both belong to exactly one case, and the case is the
# resource — the same derivation `evidence_item` already uses.
#
# **What actually runs today is a check on the parent case.** The routes load
# the row, read its `case_id`, and ask `can_view`/`can_edit` on `case:{id}`,
# which is exactly what these derivations compute — so no tuple is written per
# hypothesis or task and none needs to be. The types are declared for the same
# reason `compartment` is: when a direct check becomes meaningful (P7 sealing,
# per-resource compartments), the model it attaches to already exists and its
# semantics are already the ones in use.
#
# Hand-written like every other platform type; the FGA-stub generator
# (P3 carryover, P7) exists for *domain* object types and still has nothing to
# emit.
type hypothesis
  relations
    define case: [case]
    define can_view: can_view from case
    define can_edit: can_edit from case

type investigation_task
  relations
    define case: [case]
    define can_view: can_view from case
    define can_edit: can_edit from case

# Object sets (T70, spec 12 §5). The first type here whose grants are about a
# *saved query* rather than about evidence, and the first with a relation that
# deliberately grants less than `viewer`.
#
# `evaluator` exists because running somebody's saved query and reading what
# they were looking for are different disclosures (spec 12 §5.2). A set
# filtering on `has_nic = '...'` discloses that identifier to everyone who can
# read the definition, regardless of what the evaluation returns — so a
# colleague can be given the answer without being given the question.
#
# `viewer` implies `evaluator`, never the other way round.
#
# Case derivation mirrors `hypothesis`: a case-scoped set belongs to exactly
# one investigation, and its members reach it without a tuple per set.
type object_set
  relations
    define case: [case]
    define editor: [user] or can_edit from case
    define viewer: [user] or editor or can_view from case
    define evaluator: [user] or viewer
